    <path
        android:fillColor="#FFB300"
        android:pathData="M43.46,54.64 L31.78,57.77 A27.5,27.5 0 0,1 78.33,33.65 A6,6 0 0,1 69.84,42.13 A15.5,15.5 0 0,0 43.46,54.64 Z" />
    <!-- The lower piece, which ends at the bottom right -->
    <path
        android:fillColor="#FFB300"
        android:pathData="M71.56,74.35 A27.5,27.5 0 0,1 26.31,64.41 L37.99,61.28 A15.5,15.5 0 0,0 63.08,65.87 A6,6 0 0,1 71.56,74.35 Z" />
